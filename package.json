{
  "name": "@payrail-one/sdk",
  "private": false,
  "version": "0.7.0",
  "description": "Multi-platform Payrail payments, Payrail Code, smart-contract and R1 game SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./api-client": {
      "types": "./dist/packages/api-client/src/index.d.ts",
      "import": "./dist/packages/api-client/src/index.js"
    },
    "./money": {
      "types": "./dist/packages/money/src/index.d.ts",
      "import": "./dist/packages/money/src/index.js"
    },
    "./wallet-core": {
      "types": "./dist/packages/wallet-core/src/index.d.ts",
      "import": "./dist/packages/wallet-core/src/index.js"
    },
    "./sms": {
      "types": "./dist/packages/sms/src/index.d.ts",
      "import": "./dist/packages/sms/src/index.js"
    },
    "./contracts": {
      "types": "./dist/packages/contracts-sdk/src/index.d.ts",
      "import": "./dist/packages/contracts-sdk/src/index.js"
    },
    "./games": {
      "types": "./dist/packages/game-sdk/src/index.d.ts",
      "import": "./dist/packages/game-sdk/src/index.js"
    },
    "./r1-funding": {
      "types": "./dist/packages/r1-funding/src/index.d.ts",
      "import": "./dist/packages/r1-funding/src/index.js"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run build && tsx --test test/*.test.mjs",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@payrail-one/asset-connectors-client": "git+ssh://git@github.com/payrail-one/asset-connectors.git#5d356c3d60a3475cbc625d2c6841f3fb31692f19",
    "@playwright/test": "1.63.0",
    "prettier": "3.8.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@scure/base": "2.4.0"
  },
  "peerDependencies": {
    "@payrail-one/asset-connectors-client": "0.1.1"
  },
  "peerDependenciesMeta": {
    "@payrail-one/asset-connectors-client": {
      "optional": true
    }
  }
}
